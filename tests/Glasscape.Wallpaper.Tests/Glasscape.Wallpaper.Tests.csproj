<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Glasscape/Wallpaper/*.cs" Link="Wallpaper/%(Filename)%(Extension)" />
    <Compile Include="../../src/Glasscape/Settings/AppSettings.cs" Link="AppSettings.cs" />
    <Compile Include="../../src/Glasscape/Localization/*.cs" Link="Localization/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/Glasscape/Localization/Strings*.resx" Link="Localization/%(Filename)%(Extension)" LogicalName="Glasscape.Localization.%(Filename).resources" />
  </ItemGroup>
</Project>
