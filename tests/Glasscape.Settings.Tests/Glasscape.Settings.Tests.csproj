<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Glasscape/Settings/*.cs" Link="Settings/%(Filename)%(Extension)" />
    <Compile Include="../../src/Glasscape/Packaging/PackageIdentity.cs" Link="Packaging/PackageIdentity.cs" />
    <Compile Include="../../src/Glasscape/Localization/*.cs" Link="Localization/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/Glasscape/Localization/Strings*.resx" Link="Localization/%(Filename)%(Extension)" LogicalName="Glasscape.Localization.%(Filename).resources" />
  </ItemGroup>
</Project>
